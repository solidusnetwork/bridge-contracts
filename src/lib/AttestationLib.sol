pragma solidity 0.8.28;

/// @title AttestationLib
/// @notice The attestation digest and the m-of-n signature check a mirror applies before it believes a
///         Solidus message.
///
/// ⛔ EVERY FIELD IN THE DIGEST CLOSES A REPLAY, and the file that proves it is
/// `test-fixtures/bridge/attestation-v2.json`, generated by `solidus-bridge-codec`:
///   · the Solidus chain id, so a devnet signature is not a testnet one;
///   · the DESTINATION domain, so a Sepolia signature is not a Fuji one;
///   · the per-domain sequence, so a signature cannot be re-presented at another slot;
///   · the message id, so the body cannot be swapped under the signatures;
///   · the height, so the claim is anchored to the block that queued it.
///
/// ⚠ ASCENDING SIGNER ORDER IS THE DUPLICATE CHECK, not a tidiness rule. One stolen key can produce
/// as many valid 65-byte strings over one digest as it likes; requiring each recovered address to be
/// STRICTLY greater than the last makes a repeat impossible in a single pass, with no array and no
/// set to allocate.
library AttestationLib {
    bytes internal constant DOMAIN = "SOLIDUS_BRIDGE_ATTESTATION_V1";

    error BadSignatureLength(uint256 length);
    error HighS(uint256 index);
    error BadSignature(uint256 index);
    error SignersOutOfOrder(address previous, address next);
    error UnknownSigner(address signer);
    error NotEnoughSignatures(uint256 got, uint256 need);

    function digest(
        uint64 solidusChainId,
        uint32 destinationDomain,
        uint64 domainSeq,
        bytes32 messageId,
        uint64 solidusHeight
    ) internal pure returns (bytes32) {
        return keccak256(
            abi.encodePacked(DOMAIN, solidusChainId, destinationDomain, domainSeq, messageId, solidusHeight)
        );
    }

    /// The SLDS TOKEN channel (phase 4): the same fields under its own tag, so a signature over a
    /// credential slot never verifies on the token channel, or the reverse. Pinned by
    /// `test-fixtures/bridge/token-attestation-v1.json`.
    bytes internal constant TOKEN_DOMAIN = "SOLIDUS_BRIDGE_TOKEN_V1";

    function tokenDigest(
        uint64 solidusChainId,
        uint32 destinationDomain,
        uint64 tokenSeq,
        bytes32 messageId,
        uint64 solidusHeight
    ) internal pure returns (bytes32) {
        return keccak256(
            abi.encodePacked(TOKEN_DOMAIN, solidusChainId, destinationDomain, tokenSeq, messageId, solidusHeight)
        );
    }

    /// EIP-191 personal-sign framing, which is what a validator's signer produces and what
    /// `ecrecover` therefore has to be given.
    function ethSigned(bytes32 d) internal pure returns (bytes32) {
        return keccak256(abi.encodePacked("\x19Ethereum Signed Message:\n32", d));
    }

    /// Reverts unless at least `threshold` distinct configured validators signed `d`.
    function verify(bytes32 d, bytes calldata signatures, mapping(address => bool) storage isValidator, uint8 threshold)
        internal
        view
    {
        if (signatures.length % 65 != 0) revert BadSignatureLength(signatures.length);
        uint256 n = signatures.length / 65;
        // ⚠ COUNTED BEFORE ANYTHING IS RECOVERED. The other order tells a caller who simply sent too
        // few that their first signature was malformed, which sends them to the wrong problem.
        if (n < threshold) revert NotEnoughSignatures(n, threshold);

        bytes32 h = ethSigned(d);
        address previous = address(0);
        for (uint256 i; i < n; ++i) {
            bytes calldata sig = signatures[i * 65:(i + 1) * 65];
            bytes32 r = bytes32(sig[0:32]);
            bytes32 s = bytes32(sig[32:64]);
            // EIP-2: the upper half of the curve order is the same signature with a flipped v.
            if (uint256(s) > 0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF5D576E7357A4501DDFE92F46681B20A0) revert HighS(i);
            address signer = ecrecover(h, uint8(sig[64]), r, s);
            if (signer == address(0)) revert BadSignature(i);
            // Ascending order IS the duplicate check: one pass, no array, no set.
            if (signer <= previous) revert SignersOutOfOrder(previous, signer);
            if (!isValidator[signer]) revert UnknownSigner(signer);
            previous = signer;
        }
    }
}
