pragma solidity 0.8.28;

import {Test} from "forge-std/Test.sol";
import {BridgeMessageCodec} from "../src/lib/BridgeMessageCodec.sol";
import {CodecHarness} from "./helpers/CodecHarness.sol";

/// ⛔ THE BYTE LAYOUT COMES FROM THE VECTORS, NEVER FROM RE-READING THE RUST. Two sides that each
/// re-derive a layout from the same prose agree until the prose is ambiguous, and then they disagree
/// on a live chain where the only symptom is a credential that reads as absent. `messages-v1.json`
/// and `ids-v1.json` are generated by `solidus-bridge-codec`; this file is the EVM side asserting
/// against the same bytes.
///
/// ⚠ EVERY CASE IN THE FILE IS READ, not a hand-copied subset. The loop walks until a case index
/// stops existing, so a case added on the Rust side fails here until the Solidity reads it too.
contract BridgeMessageCodecVectorsTest is Test {
    CodecHarness internal harness;
    string internal messages;
    string internal ids;

    function setUp() public {
        harness = new CodecHarness();
        string memory dir = string.concat(vm.projectRoot(), "/test-fixtures/bridge/");
        messages = vm.readFile(string.concat(dir, "messages-v1.json"));
        ids = vm.readFile(string.concat(dir, "ids-v1.json"));
    }

    // ---------------------------------------------------------------- positive cases

    function test_every_message_case_decodes_to_its_fields() public view {
        uint256 seen;
        for (uint256 i = 0; vm.keyExistsJson(messages, _at("cases", i, "name")); i++) {
            string memory name = vm.parseJsonString(messages, _at("cases", i, "name"));
            bytes memory body = vm.parseJsonBytes(messages, _at("cases", i, "hex"));
            string memory kind = vm.parseJsonString(messages, _at("cases", i, "fields.kind"));

            BridgeMessageCodec.Header memory h = harness.header(body);
            assertEq(h.version, 1, name);
            assertEq(h.domainSeq, _u64(messages, _at("cases", i, "fields.domainSeq")), name);
            assertEq(h.solidusHeight, _u64(messages, _at("cases", i, "fields.solidusHeight")), name);

            if (_is(kind, "credential_status")) {
                assertEq(h.kind, BridgeMessageCodec.KIND_CREDENTIAL_STATUS, name);
                BridgeMessageCodec.CredentialStatus memory c = harness.credentialStatus(body);
                assertEq(c.exportId, vm.parseJsonBytes32(messages, _at("cases", i, "fields.exportId")), name);
                assertEq(c.issuerDidHash, vm.parseJsonBytes32(messages, _at("cases", i, "fields.issuerDidHash")), name);
                assertEq(
                    c.credentialTypeHash,
                    vm.parseJsonBytes32(messages, _at("cases", i, "fields.credentialTypeHash")),
                    name
                );
                assertEq(c.holder, vm.parseJsonBytes32(messages, _at("cases", i, "fields.holder")), name);
                assertEq(uint256(c.status), vm.parseJsonUint(messages, _at("cases", i, "fields.status")), name);
                assertEq(c.validUntil, _u64(messages, _at("cases", i, "fields.validUntil")), name);
                assertEq(
                    c.issuerAccredited, vm.parseJsonBool(messages, _at("cases", i, "fields.issuerAccredited")), name
                );
            } else if (_is(kind, "issuer_status")) {
                assertEq(h.kind, BridgeMessageCodec.KIND_ISSUER_STATUS, name);
                BridgeMessageCodec.IssuerStatus memory s = harness.issuerStatus(body);
                assertEq(s.issuerDidHash, vm.parseJsonBytes32(messages, _at("cases", i, "fields.issuerDidHash")), name);
                assertEq(s.accredited, vm.parseJsonBool(messages, _at("cases", i, "fields.accredited")), name);
            } else if (_is(kind, "heartbeat")) {
                assertEq(h.kind, BridgeMessageCodec.KIND_HEARTBEAT, name);
                BridgeMessageCodec.Heartbeat memory b = harness.heartbeat(body);
                assertEq(b.solidusTimestamp, _u64(messages, _at("cases", i, "fields.solidusTimestamp")), name);
                assertEq(b.globalRoot, vm.parseJsonBytes32(messages, _at("cases", i, "fields.globalRoot")), name);
            } else {
                revert(string.concat("messages-v1.json has a kind this test does not read: ", kind));
            }
            seen++;
        }
        // ⚠ A LOOP THAT FINDS NOTHING PASSES. Without this the whole test is vacuous the day a path
        // typo makes `keyExistsJson` false on the first index.
        assertEq(seen, 5, "messages-v1.json case count changed; read the new case, do not change this number blindly");
    }

    // ---------------------------------------------------------------- negative cases

    /// Each negative case is routed to `credentialStatus`, including the empty one: five of the six
    /// are credential-status shaped, and the empty input must fail on length before it reads a byte.
    function test_every_negative_case_reverts_with_the_mapped_error() public {
        uint256 seen;
        for (uint256 i = 0; vm.keyExistsJson(messages, _at("negative", i, "name")); i++) {
            bytes memory body = vm.parseJsonBytes(messages, _at("negative", i, "hex"));
            string memory err = vm.parseJsonString(messages, _at("negative", i, "error"));

            // `BadLength` carries two arguments this file does not know, so the assertion is on the
            // selector. The unit test pins the full error with its values.
            vm.expectPartialRevert(_selector(err));
            harness.credentialStatus(body);
            seen++;
        }
        assertEq(seen, 6, "messages-v1.json negative count changed");
    }

    // ---------------------------------------------------------------- ids

    function test_export_id_matches_the_vectors() public view {
        uint256 seen;
        for (uint256 i = 0; vm.keyExistsJson(ids, _at("exportId", i, "expected")); i++) {
            bytes32 got = harness.exportId(
                vm.parseJsonString(ids, _at("exportId", i, "credentialId")),
                uint32(vm.parseJsonUint(ids, _at("exportId", i, "domain"))),
                vm.parseJsonBytes32(ids, _at("exportId", i, "holder"))
            );
            assertEq(got, vm.parseJsonBytes32(ids, _at("exportId", i, "expected")));
            seen++;
        }
        assertEq(seen, 3, "ids-v1.json exportId count changed");
    }

    function test_gate_key_matches_the_vectors() public view {
        uint256 seen;
        for (uint256 i = 0; vm.keyExistsJson(ids, _at("gateKey", i, "expected")); i++) {
            bytes32 got = harness.gateKey(
                vm.parseJsonBytes32(ids, _at("gateKey", i, "holder")),
                vm.parseJsonBytes32(ids, _at("gateKey", i, "credentialTypeHash")),
                vm.parseJsonBytes32(ids, _at("gateKey", i, "issuerDidHash"))
            );
            assertEq(got, vm.parseJsonBytes32(ids, _at("gateKey", i, "expected")));
            seen++;
        }
        assertEq(seen, 1, "ids-v1.json gateKey count changed");
    }

    // ---------------------------------------------------------------- helpers

    function _at(string memory array, uint256 i, string memory field) internal pure returns (string memory) {
        return string.concat(".", array, "[", vm.toString(i), "].", field);
    }

    /// The u64 fields are JSON STRINGS, because 18446744073709551615 does not survive a JSON number.
    function _u64(string memory json, string memory path) internal pure returns (uint64) {
        return uint64(vm.parseUint(vm.parseJsonString(json, path)));
    }

    function _is(string memory a, string memory b) internal pure returns (bool) {
        return keccak256(bytes(a)) == keccak256(bytes(b));
    }

    function _selector(string memory name) internal pure returns (bytes4) {
        if (_is(name, "BadLength")) return BridgeMessageCodec.BadLength.selector;
        if (_is(name, "BadVersion")) return BridgeMessageCodec.BadVersion.selector;
        if (_is(name, "UnknownKind")) return BridgeMessageCodec.UnknownKind.selector;
        if (_is(name, "BadStatus")) return BridgeMessageCodec.BadStatus.selector;
        if (_is(name, "BadBool")) return BridgeMessageCodec.BadBool.selector;
        revert(string.concat("unmapped error name in messages-v1.json: ", name));
    }
}
